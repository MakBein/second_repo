{
  "gui": {
    "theme": "dark",
    "sound_alerts": true,
    "default_trap_type": "html",
    "max_report_line_length": 110
  },

  "honeypot": {
    "enable": true,
    "poll_interval": 4,
    "log_path": "LOG_DIR/honeypot.log",
    "hits_log_path": "LOG_DIR/honeypot_hits.log"
  },

  "crawl": {
    "depth_limit": 3,
    "error_log": "LOG_DIR/crawler_errors.log"
  },

  "http": {
    "request_timeout": 7,
    "default_user_agent": "XSS-Security-GUI/6.5"
  },

  "anti_detection": {
    "use_tls_client": true
  },

  "idor": {
    "delay": 0.5
  },

  "lfi": {
    "delay": 0.5,
    "payloads": [
      "../../etc/passwd",
      "../../../etc/passwd",
      "../../../../etc/passwd",
      "..%2f..%2fetc%2fpasswd",
      "..\\\\..\\\\windows\\\\win.ini",
      "/etc/passwd",
      "..%252f..%252fetc%252fpasswd"
    ],
    "signatures": [
      "root:x",
      "[extensions]",
      "[fonts]",
      "[drivers]"
    ]
  },

  "sqli": {
    "error_indicators": [
      "sql syntax", "mysql", "postgres", "sqlite", "odbc",
      "warning", "fatal error", "unclosed quotation mark",
      "unexpected end of input", "query failed",
      "native client", "syntax error", "invalid query",
      "unexpected token", "unterminated string", "invalid column"
    ],
    "waf_indicators": [
      "waf", "blocked", "forbidden", "security", "mod_security",
      "access denied", "firewall", "request rejected"
    ]
  },

  "ssrf": {
    "body_indicators": [
      "169.254.", "metadata", "ec2", "internal", "localhost", "127.0.0.1",
      "google.internal", "azure", "gcp", "aws", "openstack",
      "file://", "ftp://", "unix://"
    ],
    "header_indicators": [
      "via", "x-forwarded-for", "x-aws-", "metadata", "x-real-ip"
    ]
  },

  "payloads": {
    "sqli_file": "PAYLOADS_DIR/sqli.json",
    "xss_file": "PAYLOADS_DIR/xss.json",
    "csrf_file": "PAYLOADS_DIR/csrf.json",
    "ssrf_file": "PAYLOADS_DIR/ssrf.json"
  },

  "threat": {
    "artifact_path": "LOG_DIR/threat_intel_artifact.json",
    "log_path": "LOG_DIR/threat_intel.log",
    "max_size_mb": 20
  },

  "export": {
    "max_line_length": 110
  },

  "threat_intel": {
    "enable": false,
    "elk_url": "",
    "splunk_url": "",
    "splunk_token": "",
    "send_full_results": true,
    "send_summary": true
  }
}

