# xss_security_gui/.gitignore
# === Python стандартное ===
__pycache__/
*.pyc
*.pyo
*.pyd
exports/*.json
exports/*.html
exports/reports/

# === Виртуальное окружение ===
.venv/
env/
venv/

# === Сборка и артефакты ===
dist/
build/
*.egg-info/
*.spec

# === IDE и редакторы ===
.vscode/
.idea/
*.swp
*.swo

# === Runtime databases ===
payloads/payload_db.db


# === Логи проекта ===
logs/
*.log

# === Конфигурации и секреты ===
.env

# === Сгенерированные отчёты ===
*.md~

# === Scan artifacts ===
attack_results*.json
autorecon_report*.html
